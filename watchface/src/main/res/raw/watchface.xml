        <!-- Activity bounds include both the numeric inset and its arc (WFF clips at bounds). Unique editor anchors: steps number, cyan runner at x=124,y=360, green arc at x=225,y=390. -->
        <ComplicationSlot slotId="20" displayName="steps_slot" x="0" y="0" width="450" height="450" supportedTypes="GOAL_PROGRESS RANGED_VALUE SHORT_TEXT EMPTY" isCustomizable="TRUE">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <BoundingRoundBox x="132" y="257" width="230" height="110" cornerRadius="8" />
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="GOAL_PROGRESS">
                <PartText x="169" y="259" width="112" height="39">
                    <Text align="CENTER" isAutoSize="TRUE">
                        <Font family="sans-serif-condensed" size="34" weight="BOLD">
                            <Template>%s<Parameter expression="numberFormat(&quot;#,##0&quot;, [COMPLICATION.GOAL_PROGRESS_VALUE])" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="316" y="330" width="43" height="18">
                    <Text align="START" isAutoSize="TRUE">
                        <Font family="sans-serif-condensed" size="13">
                            <Template>%s<Parameter expression="[COMPLICATION.GOAL_PROGRESS_TARGET_VALUE] &gt; 0 ? numberFormat(&quot;#,##0&quot;, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) : &quot;—&quot;" /></Template>
                        </Font>
