<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-authored WFF 4. Native renderer only; no application code. -->
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <UserConfigurations>
        <ListConfiguration id="left_inset" displayName="left_inset" defaultValue="0">
            <ListOption id="0" displayName="native_weather" />
            <ListOption id="1" displayName="custom_complication" />
        </ListConfiguration>
        <BooleanConfiguration id="seconds" displayName="seconds_hand" defaultValue="FALSE" />
    </UserConfigurations>
    <Scene backgroundColor="#000000">
        <!-- The wheel is below an opaque dial with a real transparent aperture.
             Its only time dependency is the daily native moon position. -->
        <Group name="interactive_dial" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartImage x="135" y="40" width="180" height="180" pivotX="0.5" pivotY="0.5">
                <Transform target="angle" value="90 - [MOON_PHASE_POSITION] * 180 / 29.530588853" />
                <Image resource="moon_disc" />
            </PartImage>
            <PartImage x="0" y="0" width="450" height="450">
                <Image resource="dial_frame" />
            </PartImage>
            <!-- The adjacent drum labels use calendar fields, never an animation
                 or UTC millisecond source. English abbreviations match the art. -->
            <PartText name="drum_month_prev" x="136" y="118" width="57" height="15" alpha="85">
                <Text align="CENTER">
                    <Font family="sans-serif-condensed" size="14" weight="BOLD">
                        <Template>%s<Parameter expression="subText(&quot;JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC&quot;, (([MONTH]+10)%12)*3, (([MONTH]+10)%12)*3+3)" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText name="drum_month" x="136" y="132" width="57" height="24">
                <Text align="CENTER">
                    <Font family="sans-serif-condensed" size="21" weight="BOLD">
                        <Template>%s<Parameter expression="subText(&quot;JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC&quot;, ([MONTH]-1)*3, [MONTH]*3)" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText name="drum_month_next" x="136" y="154" width="57" height="13" alpha="70">
                <Text align="CENTER">
                    <Font family="sans-serif-condensed" size="12" weight="BOLD">
                        <Template>%s<Parameter expression="subText(&quot;JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC&quot;, ([MONTH]%12)*3, ([MONTH]%12)*3+3)" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText name="drum_weekday_prev" x="197" y="118" width="55" height="15" alpha="85">
                <Text align="CENTER">
                    <Font family="sans-serif-condensed" size="14" weight="BOLD">
                        <Template>%s<Parameter expression="subText(&quot;SUNMONTUEWEDTHUFRISAT&quot;, (([DAY_OF_WEEK]+5)%7)*3, (([DAY_OF_WEEK]+5)%7)*3+3)" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText name="drum_weekday" x="197" y="132" width="55" height="24">
                <Text align="CENTER">
                    <Font family="sans-serif-condensed" size="21" weight="BOLD" color="#FF6A15">
                        <Template>%s<Parameter expression="subText(&quot;SUNMONTUEWEDTHUFRISAT&quot;, ([DAY_OF_WEEK]-1)*3, [DAY_OF_WEEK]*3)" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText name="drum_weekday_next" x="197" y="154" width="55" height="13" alpha="70">
                <Text align="CENTER">
                    <Font family="sans-serif-condensed" size="12" weight="BOLD">
                        <Template>%s<Parameter expression="subText(&quot;SUNMONTUEWEDTHUFRISAT&quot;, ([DAY_OF_WEEK]%7)*3, ([DAY_OF_WEEK]%7)*3+3)" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText name="drum_date_prev" x="258" y="118" width="55" height="15" alpha="85">
                <Text align="CENTER">
                    <Font family="sans-serif-condensed" size="14" weight="BOLD">
                        <Template>%s<Parameter expression="numberFormat(&quot;00&quot;, [DAY] &gt; 1 ? [DAY]-1 : ([MONTH] == 3 ? (([YEAR]%4 == 0 &amp;&amp; ([YEAR]%100 != 0 || [YEAR]%400 == 0)) ? 29 : 28) : (([MONTH] == 5 || [MONTH] == 7 || [MONTH] == 10 || [MONTH] == 12) ? 30 : 31)))" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText name="drum_date" x="258" y="132" width="55" height="24">
                <Text align="CENTER">
                    <Font family="sans-serif-condensed" size="21" weight="BOLD">
                        <Template>%s<Parameter expression="[DAY_Z]" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText name="drum_date_next" x="258" y="154" width="55" height="13" alpha="70">
                <Text align="CENTER">
                    <Font family="sans-serif-condensed" size="12" weight="BOLD">
                        <Template>%s<Parameter expression="numberFormat(&quot;00&quot;, [DAY] &lt; ([MONTH] == 2 ? (([YEAR]%4 == 0 &amp;&amp; ([YEAR]%100 != 0 || [YEAR]%400 == 0)) ? 29 : 28) : (([MONTH] == 4 || [MONTH] == 6 || [MONTH] == 9 || [MONTH] == 11) ? 30 : 31)) ? [DAY]+1 : 1)" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartImage name="battery_slider" x="367" y="274" width="21" height="13">
                <Transform target="y" value="274 - 99 * clamp([BATTERY_PERCENT], 0, 100) / 100" />
                <Image resource="battery_slider" />
            </PartImage>
            <PartDraw x="0" y="0" width="450" height="450">
                <Transform target="alpha" value="[BATTERY_PERCENT] &lt;= 20 ? 255 : 0" />
                <RoundRectangle x="366" y="274" width="5" height="13" cornerRadiusX="2" cornerRadiusY="2">
                    <Fill color="#FFD535" />
                </RoundRectangle>
            </PartDraw>
            <PartDraw x="0" y="0" width="450" height="450">
                <Transform target="alpha" value="[BATTERY_PERCENT] &lt;= 10 ? 255 : 0" />
                <RoundRectangle x="385" y="274" width="5" height="13" cornerRadiusX="2" cornerRadiusY="2">
                    <Fill color="#FF352A" />
                </RoundRectangle>
            </PartDraw>
            <!-- Default weather uses the native system data contract. A separate
                 custom mode prevents pretending generic text contains a high. -->
            <Group name="weather" x="0" y="0" width="450" height="450">
                <ListConfiguration id="left_inset">
                    <ListOption id="0">
                        <Group name="weather_content" x="0" y="0" width="450" height="450">
                            <Condition>
                                <Expressions>
                                    <Expression name="weather_available">[WEATHER.IS_AVAILABLE]</Expression>
                                </Expressions>
                                <Compare expression="weather_available">
                                    <Condition>
                                        <Expressions>
                                            <Expression name="clear_night">([WEATHER.CONDITION] == 1 || [WEATHER.CONDITION] == 8) &amp;&amp; ![WEATHER.IS_DAY]</Expression>
                                            <Expression name="partly_night">[WEATHER.CONDITION] == 14 &amp;&amp; ![WEATHER.IS_DAY]</Expression>
                                        </Expressions>
                                        <Compare expression="clear_night">
                                            <PartImage x="63" y="212" width="47" height="47">
                                                <Image resource="wx_16" />
                                            </PartImage>
                                        </Compare>
                                        <Compare expression="partly_night">
                                            <PartImage x="63" y="212" width="47" height="47">
                                                <Image resource="wx_17" />
                                            </PartImage>
                                        </Compare>
                                        <Default>
                                            <Condition>
                                                <Expressions>
                                                    <Expression name="wx_1">[WEATHER.CONDITION] == 1</Expression>
                                                    <Expression name="wx_2">[WEATHER.CONDITION] == 2</Expression>
                                                    <Expression name="wx_3">[WEATHER.CONDITION] == 3</Expression>
                                                    <Expression name="wx_4">[WEATHER.CONDITION] == 4</Expression>
                                                    <Expression name="wx_5">[WEATHER.CONDITION] == 5</Expression>
                                                    <Expression name="wx_6">[WEATHER.CONDITION] == 6</Expression>
                                                    <Expression name="wx_7">[WEATHER.CONDITION] == 7</Expression>
                                                    <Expression name="wx_8">[WEATHER.CONDITION] == 8</Expression>
                                                    <Expression name="wx_9">[WEATHER.CONDITION] == 9</Expression>
                                                    <Expression name="wx_10">[WEATHER.CONDITION] == 10</Expression>
                                                    <Expression name="wx_11">[WEATHER.CONDITION] == 11</Expression>
                                                    <Expression name="wx_12">[WEATHER.CONDITION] == 12</Expression>
                                                    <Expression name="wx_13">[WEATHER.CONDITION] == 13</Expression>
                                                    <Expression name="wx_14">[WEATHER.CONDITION] == 14</Expression>
                                                    <Expression name="wx_15">[WEATHER.CONDITION] == 15</Expression>
                                                </Expressions>
                                                <Compare expression="wx_1">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_1" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_2">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_2" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_3">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_3" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_4">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_4" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_5">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_5" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_6">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_6" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_7">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_7" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_8">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_8" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_9">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_9" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_10">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_10" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_11">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_11" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_12">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_12" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_13">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_13" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_14">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_14" />
                                                    </PartImage>
                                                </Compare>
                                                <Compare expression="wx_15">
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_15" />
                                                    </PartImage>
                                                </Compare>
                                                <Default>
                                                    <PartImage x="63" y="212" width="47" height="47">
                                                        <Image resource="wx_0" />
                                                    </PartImage>
                                                </Default>
                                            </Condition>
                                        </Default>
                                    </Condition>
                                    <PartText x="52" y="256" width="75" height="34">
                                        <Text align="CENTER">
                                            <Font family="sans-serif-condensed" size="29" weight="BOLD">
                                                <Template>%s°<Parameter expression="[WEATHER.TEMPERATURE]" /></Template>
                                            </Font>
                                        </Text>
                                    </PartText>
                                    <PartText x="52" y="287" width="75" height="18">
                                        <Text align="CENTER">
                                            <Font family="sans-serif-condensed" size="14" weight="BOLD">
                                                <Template>H %s°%s<Parameter expression="[WEATHER.DAY_TEMPERATURE_HIGH]" /><Parameter expression="[WEATHER.TEMPERATURE_UNIT] == 1 ? &quot;C&quot; : &quot;F&quot;" /></Template>
                                            </Font>
                                        </Text>
                                    </PartText>
                                    <PartText x="111" y="251" width="14" height="13">
                                        <Transform target="alpha" value="[WEATHER.IS_ERROR] ? 255 : 0" />
                                        <Text align="CENTER">
                                            <Font family="sans-serif" size="11" color="#FFD535">!</Font>
                                        </Text>
                                    </PartText>
                                </Compare>
                                <Default>
                                    <PartImage x="63" y="212" width="47" height="47">
                                        <Image resource="wx_0" />
                                    </PartImage>
                                    <PartText x="52" y="256" width="75" height="34">
                                        <Text align="CENTER">
                                            <Font family="sans-serif-condensed" size="29">—</Font>
                                        </Text>
                                    </PartText>
                                    <PartText x="52" y="287" width="75" height="18">
                                        <Text align="CENTER">
                                            <Font family="sans-serif-condensed" size="14">H —</Font>
                                        </Text>
