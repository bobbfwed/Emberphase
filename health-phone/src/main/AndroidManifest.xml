<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.sec.android.app.shealth" /></queries>
    <application android:label="Emberphase Health" android:icon="@drawable/ic_emberphase_health"
        android:allowBackup="false" android:dataExtractionRules="@xml/health_backup_rules"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".HealthActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".WatchRefreshListener" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/emberphase/activity/refresh" />
            </intent-filter>
        </service>
    </application>
</manifest>
